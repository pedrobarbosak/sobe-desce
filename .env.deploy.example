# Copy to .env.deploy and fill in. Never commit it, and never copy it between machines:
# the admin key, the tunnel user and INSTANCE_SECRET all belong to one host.
# ./scripts/bootstrap.sh creates it and generates the secrets for you.
#
# Values are single-quoted. Both bash and Compose's dotenv parser read that form
# literally, which matters for keys containing | and secrets containing / or +.

# --- public hostnames (must match the tunnel and the Discord redirect) ---
# APP_HOST is a bare hostname; the other two are full URLs.
APP_HOST='sobe-desce.example.com'
CONVEX_CLOUD_ORIGIN='https://sobe-desce-api.example.com'
CONVEX_SITE_ORIGIN='https://sobe-desce-actions.example.com'

# --- backend identity ---
INSTANCE_NAME='sobe-desce'
# openssl rand -hex 32. Generated by bootstrap.sh. Changing it orphans the database.
INSTANCE_SECRET=
# Minted by deploy.sh on its first run, from the running backend.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- application settings, pushed onto the deployment by deploy.sh ---
# openssl rand -base64 32. Generated by bootstrap.sh. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Optional sign-in providers. Leave blank and the provider does not appear at all.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID='common'
# Magic-link email. Without a key the link is printed in the backend logs instead.
RESEND_API_KEY=
EMAIL_FROM=

# --- cloudflare tunnel ---
TUNNEL_NAME='sobe-desce'
# Written by tunnel.sh: the uid:gid that owns the credentials file, so the container
# (which defaults to 65532) can read it without the file being world readable.
TUNNEL_USER=
# 4, 6 or auto. Defaults to 4: a Docker network has no IPv6 route, and cloudflared's own
# default picks IPv6 edge addresses and then cannot reach them.
TUNNEL_EDGE_IP_VERSION='4'


# --- ports and images, all optional ---
# Published on 127.0.0.1 only. Change them if something else on the host already binds
# these; a dev machine running another Convex project usually does.
BACKEND_PORT='3210'
SITE_PORT='3211'
WEB_PORT='8080'
DASHBOARD_PORT='6791'
# Where deploy.sh reaches the backend to push functions. Local, so it does not need the
# tunnel. Follows BACKEND_PORT unless you set it.
CONVEX_ADMIN_URL=
# Pin these for a stateful backend rather than tracking :latest.
CONVEX_REV='latest'
WEB_TAG='latest'
